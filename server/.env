
# Both endpoints must be OpenAI-compatible LiteRouter HTTPS API roots.
LITEROUTER_PRIMARY_BASE_URL=https://api.literouter.com/v1
LITEROUTER_PRIMARY_API_KEY=05ce854c36d3be8ccc801c0d7539f870df57313bd67a613fa3aab97fce0d1546
LITEROUTER_PRIMARY_MODEL=deepseek:free

# Independent fallback endpoint and credentials. Do not reuse the primary key
# unless both servers intentionally share the same account.
LITEROUTER_SECONDARY_BASE_URL=https://secondary.example.com/v1
LITEROUTER_SECONDARY_API_KEY=REPLACE_WITH_SECONDARY_SERVER_KEY
LITEROUTER_SECONDARY_MODEL=deepseek:free

UPSTREAM_TIMEOUT_SECONDS=90
MAX_MESSAGES=80
MAX_CONTENT_CHARS=16000
